{
  "name": "zerocloud-media-library",
  "private": true,
  "version": "0.3.0",
  "description": "Private, local-first media library and disk backup workspace",
  "author": "Gnaneshwar-ux",
  "repository": "https://github.com/Gnaneshwar-ux/ZeroCloud",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/inline-static-build.mjs",
    "lint": "oxlint",
    "verify:local": "node scripts/verify-local-library.mjs",
    "preview": "vite preview",
    "desktop:dev": "electron desktop/main.cjs",
    "desktop:build": "pnpm build",
    "desktop:package": "pnpm build && node scripts/package-desktop.mjs",
    "release:windows": "electron-builder --win nsis --x64 --config electron-builder.yml",
    "verify:desktop": "node scripts/verify-desktop.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.2",
    "heic-to": "^1.6.5",
    "leaflet": "1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "playwright": "^1.64.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
